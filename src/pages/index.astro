            <rect x="58"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
