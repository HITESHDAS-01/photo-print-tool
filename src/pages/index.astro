---
import Layout from '../layouts/Layout.astro';
import PhotoPrintTool from '../components/PhotoPrintTool.astro';

const siteUrl = 'https://photo-print-tool.pages.dev';

const faqs = [
  {
    q: 'Can I print passport photos and ID cards on the same A4 sheet?',
    a: 'Yes — you can mix passport, stamp, PAN, and ID card sizes on a single A4 page. Add each photo, choose its size, and the tool arranges everything on A4 pages so you can cut them apart after printing.',
  },
  {
    q: 'What size are Aadhar, Voter ID, and PAN cards for printing?',
    a: 'Physical Indian ID cards (Aadhar, Voter ID/EPIC, PAN, Driving License) all follow the standard CR-80 card size of 85.6 × 54mm — the same size as a debit or credit card. Select "ID Card" in the size dropdown for this exact dimension.',
  },
  {
    q: 'Does this tool upload my photos to a server?',
    a: 'No — every photo you add is processed entirely inside your browser using the Canvas API. Nothing is uploaded anywhere, which keeps your ID documents and personal photos private.',
  },
  {
    q: 'Can I control how many copies of each photo get printed?',
    a: 'Yes, each photo has its own copies field and a "Fill Page" button that automatically calculates how many copies of that size fit one A4 page, based on your current margin and gap settings.',
  },
  {
    q: 'How do I export the layout as a PDF?',
    a: 'Click "Print / Save as PDF" to open your browser\'s native print dialog, then choose "Save as PDF" as the destination instead of a physical printer. The A4 layout is pre-formatted for print.',
  },
  {
    q: 'Does this work on mobile phones?',
    a: 'Yes — the layout is fully responsive and works on Android and iOS browsers. You can upload photos directly from your camera or gallery on any modern mobile browser.',
  },
  {
    q: 'What photo sizes does the tool support?',
    a: 'The tool supports passport (3.5×4.5cm), stamp (2×2.5cm), PAN application (2.5×3.5cm), US visa (2×2 inch), CR-80 ID card (85.6×54mm), postcard (4×6 inch), and fully custom dimensions you enter yourself.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Photo Print Tool',
  description: 'Free online tool to arrange passport photos, ID cards (Aadhar, PAN, Voter ID), and stamp-size photos on one A4 page. Print or save as PDF instantly — 100% browser-based, no upload.',
  url: siteUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (Web Browser)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
  },
  featureList: [
    'Arrange passport photos on A4 pages',
    'ID card sizes: Aadhar, PAN, Voter ID (CR-80)',
    'Stamp size and PAN application photos',
    'US Visa photo format',
    'Custom photo dimensions',
    'Automatic A4 layout with cutting guides',
    'Export as PDF or print directly',
    '100% browser-based — no uploads',
    'Manual drag-and-drop positioning',
    'Undo/Redo support',
  ],
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Photo Print Tool',
  url: siteUrl,
  logo: `${siteUrl}/icons/icon-512.png`,
  description: 'Free browser-based tool for arranging passport photos and ID cards on A4 pages.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Print Passport Photos at Home',
  description: 'Arrange passport photos, ID cards, and stamp-size photos on an A4 page and print them at home or save as PDF.',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Upload Photos',
      text: 'Click "Add Photos" and select images from your gallery or camera. Drag and drop also works. Your photos are processed locally in your browser — nothing is uploaded.',
    },
    {
      '@type': 'HowToStep',
      name: 'Choose Size',
      text: 'Pick passport, stamp, PAN application, US Visa, or ID Card size for each photo. Use the "Fill Page" button to auto-calculate how many copies fit one A4 page.',
    },
    {
      '@type': 'HowToStep',
      name: 'Print or Save PDF',
      text: 'Click "Print / Save as PDF" — choose "Save as PDF" in the print dialog to export, or send directly to your printer. Crop marks guide your cuts.',
    },
  ],
};
---

<Layout
  title="Photo Print Layout Tool — Arrange Multiple Photos on A4 & Export PDF"
  description="Free online tool to arrange passport photos, ID cards (Aadhar, PAN, Voter ID), and stamp-size photos on one A4 page. Print or save as PDF instantly — 100% browser-based, no upload."
>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="header-brand">
        <svg viewBox="0 0 24 24" fill="none" width="28" height="28"><rect x="3" y="7" width="18" height="13" rx="2" stroke="#F5AE0A" stroke-width="1.8"/><circle cx="12" cy="14" r="3.4" stroke="#F5AE0A" stroke-width="1.8"/><path d="M8 7l1.2-2.5h5.6L16 7" stroke="#F5AE0A" stroke-width="1.8"/></svg>
        <span>Photo Print Tool</span>
      </a>
      <nav class="header-actions">
        <a href="/about" class="header-btn">About</a>
        <a href="/contact" class="header-btn">Contact</a>
      </nav>
      <span class="header-badge">100% Free & Private</span>
    </div>
  </header>

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-title">Print Passport Photos &amp; ID Cards <em>Instantly</em></h1>
        <p class="hero-sub">Arrange multiple photos on A4 pages — passport size, stamp size, PAN application, or CR-80 ID cards. Save as PDF or print directly. No upload, no signup.</p>
      </div>
      <div class="hero-illustration" aria-hidden="true">
        <svg viewBox="0 0 200 283" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- A4 page -->
          <rect x="0" y="0" width="200" height="283" rx="3" fill="#fff" stroke="rgba(255,255,255,0.08)" stroke-width="0.5"/>
          <!-- Crop marks -->
          <g stroke="rgba(217,142,43,0.25)" stroke-width="0.6">
            <line x1="8" y1="0" x2="8" y2="5"/><line x1="0" y1="10" x2="5" y2="10"/>
            <line x1="192" y1="0" x2="192" y2="5"/><line x1="195" y1="10" x2="200" y2="10"/>
            <line x1="8" y1="278" x2="8" y2="283"/><line x1="0" y1="273" x2="5" y2="273"/>
            <line x1="192" y1="278" x2="192" y2="283"/><line x1="195" y1="273" x2="200" y2="273"/>
          </g>
          <!-- Photos grid -->
          <g>
            <rect x="10"  y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="154" y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="178" y="14" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>

            <rect x="10"  y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="154" y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="178" y="44" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>

            <rect x="10"  y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="154" y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="178" y="74" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>

            <rect x="10"  y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
