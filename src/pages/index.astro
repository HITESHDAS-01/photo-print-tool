            <rect x="178" y="104" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>

            <rect x="10"  y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="154" y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="178" y="134" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>

            <rect x="10"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="34"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="58"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="82"  y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="106" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="130" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="154" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
            <rect x="178" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
          </g>
          <!-- Dashed cut lines between rows -->
          <g stroke="rgba(255,255,255,0.07)" stroke-width="0.5" stroke-dasharray="2.5 2">
            <line x1="5" y1="42" x2="195" y2="42"/>
            <line x1="5" y1="72" x2="195" y2="72"/>
            <line x1="5" y1="102" x2="195" y2="102"/>
            <line x1="5" y1="132" x2="195" y2="132"/>
            <line x1="5" y1="162" x2="195" y2="162"/>
            <line x1="5" y1="192" x2="195" y2="192"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <main class="tool-section">
    <PhotoPrintTool />
  </main>

  <section class="steps-section">
    <div class="steps-inner">
      <h2 class="section-title">How It Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Upload Photos</h3>
          <p>Click "Add Photos" and select images from your gallery or camera — drag and drop also works. Your photos are processed entirely in your browser and never leave your device.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Choose Size</h3>
          <p>Pick passport, stamp, PAN application, US Visa, or ID Card size for each photo. Use the "Fill Page" button to auto-calculate how many copies fit one A4 page for that exact size.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Print or Save PDF</h3>
          <p>Click "Print / Save as PDF" — choose "Save as PDF" in the print dialog to export, or send directly to your printer. Crop marks guide your cuts for clean, professional results.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="features-section">
    <div class="features-inner">
      <h2 class="section-title">Why Use This Tool?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>100% Private</h3>
          <p>All photo processing happens inside your browser using the Canvas API. Photos never leave your device — critical when handling identity documents like Aadhar, PAN cards, or passports.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 2v20M2 12h20" stroke="#272019" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <h3>Completely Free</h3>
          <p>No limits, no watermarks, no sign-up required. Use it as many times as you need — no accounts, no credit card, no trial periods. Just upload and print.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#272019" stroke-width="1.6"/><path d="M3 9h18M9 3v18" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>A4 Optimized</h3>
          <p>Automatically arranges photos to fit A4 pages with crop marks and cutting guides. Adjust margins and gaps between photos for clean, precise cuts.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" stroke="#272019" stroke-width="1.6" stroke-linecap="round"/><rect x="3" y="3" width="18" height="18" rx="2" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>Multiple Sizes</h3>
          <p>Supports passport (3.5×4.5cm), stamp (2×2.5cm), PAN application (2.5×3.5cm), US visa (2×2 inch), CR-80 ID card (85.6×54mm), postcard (4×6 inch), and fully custom dimensions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner">
      <h2 class="section-title">About Photo Print Tool</h2>
      <p>Photo Print Tool is a free, browser-based utility for arranging passport photos, ID cards, and stamp-size photos on A4 pages. It handles common Indian document sizes (Aadhar, PAN, Voter ID, Driving License) as well as US Visa photos and custom dimensions. The tool automatically arranges photos in a grid layout with crop marks so you can print and cut them at home.</p>

      <p>Getting passport photos printed used to mean visiting a photo studio or using clunky desktop software. This tool makes the process instant: upload your photos, pick the size from the dropdown, and print or save as PDF — all from your browser, with no software installation. You can even mix different sizes on a single A4 page, so passport photos and ID cards can be printed together.</p>

      <p>Every photo you upload is processed entirely inside your browser using the Canvas API. No data is ever sent to any server, which is especially important when handling identity documents. Your photos stay on your device at all times.</p>

      <p>The tool supports undo and redo, manual positioning mode, rotation and straightening, zoom, and a compare mode to preview the clean layout. On mobile, you can upload photos directly from your camera. The print dialog supports "Save as PDF" on all modern browsers, so you can store the layout digitally and print it later.</p>
    </div>
  </section>

  <section class="sizes-section">
    <div class="sizes-inner">
      <h2 class="section-title">Supported Photo Sizes</h2>
      <div class="sizes-table-wrap">
        <table class="sizes-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Dimensions</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Passport Photo</td><td>3.5 × 4.5 cm</td></tr>
            <tr><td>Stamp Size Photo</td><td>2 × 2.5 cm</td></tr>
            <tr><td>PAN Application Photo</td><td>2.5 × 3.5 cm</td></tr>
            <tr><td>US Visa Photo</td><td>2 × 2 inch (5.1 × 5.1 cm)</td></tr>
            <tr><td>ID Card (Aadhar / PAN / Voter ID)</td><td>8.56 × 5.4 cm (CR-80)</td></tr>
            <tr><td>Postcard</td><td>4 × 6 inch (10.16 × 15.24 cm)</td></tr>
            <tr><td>Custom Size</td><td>Any width × height you enter</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="faq-inner">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{f.q}</span>
              <span class="faq-icon">+</span>
            </summary>
            <p class="faq-answer">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <nav class="footer-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <p>Photo Print Tool — Free, private, browser-based. No uploads, no accounts.</p>
      <p class="footer-sub">Built with Astro. All processing happens locally in your browser.</p>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
