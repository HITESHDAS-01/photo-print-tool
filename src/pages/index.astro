            <rect x="178" y="164" width="20" height="26" rx="1" fill="#d98e2b" opacity="0.22"/>
          </g>
          <!-- Dashed cut lines between rows -->
          <g stroke="rgba(255,255,255,0.07)" stroke-width="0.5" stroke-dasharray="2.5 2">
            <line x1="5" y1="42" x2="195" y2="42"/>
            <line x1="5" y1="72" x2="195" y2="72"/>
            <line x1="5" y1="102" x2="195" y2="102"/>
            <line x1="5" y1="132" x2="195" y2="132"/>
            <line x1="5" y1="162" x2="195" y2="162"/>
            <line x1="5" y1="192" x2="195" y2="192"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <main class="tool-section">
    <PhotoPrintTool />
  </main>

  <section class="steps-section">
    <div class="steps-inner">
      <h2 class="section-title">How It Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Upload Photos</h3>
          <p>Tap "Add Photos" and select images from your gallery or camera. Drag and drop also works.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Choose Size</h3>
          <p>Pick passport, stamp, PAN application, US Visa, or ID Card size for each photo. Use "Fill Page" to auto-calculate copies.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Print or Save PDF</h3>
          <p>Click "Print / Save as PDF" — choose "Save as PDF" in the print dialog to export, or send directly to your printer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="features-section">
    <div class="features-inner">
      <h2 class="section-title">Why Use This Tool?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>100% Private</h3>
          <p>All processing happens in your browser. Photos never leave your device — critical for ID documents.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 2v20M2 12h20" stroke="#272019" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <h3>Completely Free</h3>
          <p>No limits, no watermarks, no sign-up required. Use it as many times as you need.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#272019" stroke-width="1.6"/><path d="M3 9h18M9 3v18" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>A4 Optimized</h3>
          <p>Automatically arranges photos to fit A4 pages with cutting guides. No wasted paper.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" stroke="#272019" stroke-width="1.6" stroke-linecap="round"/><rect x="3" y="3" width="18" height="18" rx="2" stroke="#272019" stroke-width="1.6"/></svg>
          </div>
          <h3>Multiple Sizes</h3>
          <p>Passport, stamp, PAN application, US Visa, and CR-80 ID card sizes (Aadhar, PAN, Voter ID).</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sizes-section">
    <div class="sizes-inner">
      <h2 class="section-title">Supported Photo Sizes</h2>
      <div class="sizes-table-wrap">
        <table class="sizes-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Dimensions</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Passport Photo</td><td>3.5 × 4.5 cm</td></tr>
            <tr><td>Stamp Size Photo</td><td>2 × 2.5 cm</td></tr>
            <tr><td>PAN Application Photo</td><td>2.5 × 3.5 cm</td></tr>
            <tr><td>US Visa Photo</td><td>2 × 2 inch (5.1 × 5.1 cm)</td></tr>
            <tr><td>ID Card (Aadhar / PAN / Voter ID)</td><td>8.56 × 5.4 cm (CR-80)</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="faq-inner">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{f.q}</span>
              <span class="faq-icon">+</span>
            </summary>
            <p class="faq-answer">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>Photo Print Tool — Free, private, browser-based. No uploads, no accounts.</p>
      <p class="footer-sub">Built with Astro. All processing happens locally in your browser.</p>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
