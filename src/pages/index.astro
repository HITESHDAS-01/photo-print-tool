---
import Layout from '../layouts/Layout.astro';
import PhotoPrintTool from '../components/PhotoPrintTool.astro';

const faqs = [
  {
    q: 'Can I print passport photos and ID cards on the same A4 sheet?',
    a: 'Yes. Add each photo, choose its size (Passport, Stamp, PAN Application Photo, or ID Card), and the tool automatically arranges everything on A4 pages so you can cut them apart after printing.',
  },
  {
    q: 'What size are Aadhar, Voter ID, and PAN cards for printing?',
    a: 'Physical Indian ID cards (Aadhar, Voter ID/EPIC, PAN, Driving License) all follow the standard CR-80 card size of 85.6 x 54mm — the same size as a debit/credit card.',
  },
  {
    q: 'Does this tool upload my photos to a server?',
    a: 'No. Every photo you add is processed entirely inside your browser — nothing is uploaded anywhere, which keeps your ID documents private.',
  },
  {
    q: 'Can I control how many copies of each photo get printed?',
    a: 'Yes, each photo has its own copies field, and a "Fill Page" button that automatically calculates how many copies fit one A4 page for that size.',
  },
  {
    q: 'How do I export the layout as a PDF?',
    a: "Click \"Print / Save as PDF\" — this opens your browser's native print dialog, where you can choose \"Save as PDF\" as the destination instead of a physical printer.",
  },
  {
    q: 'Does this work on mobile phones?',
    a: 'Yes, the layout is fully responsive and works on Android and iOS browsers, including uploading photos directly from your camera.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Photo Print Layout Tool — Arrange Multiple Photos on A4 & Export PDF"
  description="Free online tool to arrange passport photos, ID cards (Aadhar, PAN, Voter ID), and stamp-size photos on one A4 page. Print or save as PDF instantly — 100% browser-based, no upload."
>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="header-brand">
        <svg viewBox="0 0 24 24" fill="none" width="28" height="28"><rect x="3" y="7" width="18" height="13" rx="2" stroke="#F5AE0A" stroke-width="1.8"/><circle cx="12" cy="14" r="3.4" stroke="#F5AE0A" stroke-width="1.8"/><path d="M8 7l1.2-2.5h5.6L16 7" stroke="#F5AE0A" stroke-width="1.8"/></svg>
        <span>Photo Print Tool</span>
      </a>
      <span class="header-badge">100% Free & Private</span>
    </div>
  </header>

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-title">Print Passport Photos &amp; ID Cards <em>Instantly</em></h1>
        <p class="hero-sub">Arrange multiple photos on A4 pages — passport size, stamp size, PAN application, or CR-80 ID cards. Save as PDF or print directly. No upload, no signup.</p>
