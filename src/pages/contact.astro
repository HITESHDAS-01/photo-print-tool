---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Photo Print Tool"
  description="Get in touch with Photo Print Tool. Report bugs, request features, or ask questions about the free photo layout tool."
>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="header-brand">
        <svg viewBox="0 0 24 24" fill="none" width="28" height="28"><rect x="3" y="7" width="18" height="13" rx="2" stroke="#F5AE0A" stroke-width="1.8"/><circle cx="12" cy="14" r="3.4" stroke="#F5AE0A" stroke-width="1.8"/><path d="M8 7l1.2-2.5h5.6L16 7" stroke="#F5AE0A" stroke-width="1.8"/></svg>
        <span>Photo Print Tool</span>
      </a>
      <nav class="header-actions">
        <a href="/" class="header-btn">Tool</a>
        <a href="/about" class="header-btn">About</a>
        <a href="/contact" class="header-btn">Contact</a>
      </nav>
    </div>
  </header>

  <main class="legal-page">
    <div class="legal-inner">
      <h1>Contact Us</h1>

      <h2>Get in Touch</h2>
      <p>Have a question, found a bug, or want to suggest a feature? We'd love to hear from you.</p>

      <div class="contact-methods">
        <div class="contact-card">
          <h3>Email</h3>
          <p>Send us an email at <a href="mailto:support@photo-print-tool.pages.dev">support@photo-print-tool.pages.dev</a></p>
        </div>
        <div class="contact-card">
          <h3>GitHub</h3>
          <p>Report issues or contribute on <a href="https://github.com/photo-print-tool" rel="noopener noreferrer" target="_blank">GitHub</a></p>
        </div>
      </div>

      <h2>What to Include</h2>
      <p>When reporting a bug or requesting a feature, please include:</p>
      <ul>
        <li>Your browser and device type (e.g., Chrome on Windows, Safari on iPhone)</li>
        <li>Steps to reproduce the issue (for bugs)</li>
        <li>A description of what you expected vs. what happened</li>
      </ul>

      <h2>Response Time</h2>
      <p>We aim to respond to all inquiries within a few days. Feature requests and bug reports are reviewed regularly.</p>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <nav class="footer-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <p>Photo Print Tool — Free, private, browser-based. No uploads, no accounts.</p>
      <p class="footer-sub">Built with Astro. All processing happens locally in your browser.</p>
    </div>
  </footer>
</Layout>
